{
  "schemaVersion": 1,
  "id": "biscuit_roll",
  "version": "${version}",
  "name": "Biscuit Roll Lib",
  "description": "An animation library",
  "authors": ["Nord_Act"],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/biscuit_roll/icon.png",
  "accessWidener" : "biscuit_roll.accesswidener",
  "environment": "*",
  "entrypoints": {
    "client": [
      "nordmods.biscuit_roll.client.BiscuitRollClient"
    ],
    "main": [
      "nordmods.biscuit_roll.BiscuitRoll"
    ]
  },
  "mixins": [
    "biscuit_roll.mixins.json",
    "biscuit_roll_debug.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "fabric-resource-loader-v1": "*",
    "minecraft": "*"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/client/renderer/SubmitNodeCollection": ["nordmods/biscuit_roll/client/internal/BRModelSubmitCollection"],
      "net/minecraft/client/renderer/SubmitNodeStorage": ["nordmods/biscuit_roll/client/internal/BRModelSubmitStorage"],
      "net/minecraft/client/renderer/entity/state/EntityRenderState": ["nordmods/biscuit_roll/client/internal/InjectedBRState"],
      "net/minecraft/client/renderer/blockentity/state/BlockEntityRenderState": ["nordmods/biscuit_roll/client/internal/InjectedBRState"],
      "com/mojang/blaze3d/vertex/PoseStack": ["nordmods/biscuit_roll/client/internal/BRMatrixStack"]
    }
  }
}
